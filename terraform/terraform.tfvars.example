# Copy to terraform.tfvars (git-ignored) to override defaults.

kube_context = "minikube"
namespace    = "gearloop"
values_file  = "values-local.yaml"
ingress_host = "gearloop.local"

# Images built inside minikube (scripts/minikube-up.sh does this):
backend_image     = { repository = "gearloop-backend", tag = "local" }
frontend_image    = { repository = "gearloop-frontend", tag = "local" }
image_pull_policy = "Never"

# Or images published by CI to GHCR:
# backend_image     = { repository = "ghcr.io/aastik-gg/gearloop-backend", tag = "<commit-sha>" }
# frontend_image    = { repository = "ghcr.io/aastik-gg/gearloop-frontend", tag = "<commit-sha>" }
# image_pull_policy = "IfNotPresent"

enable_monitoring = true
